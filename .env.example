# Groq AI (get key from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Zernio (get key from your Zernio dashboard)
# Base URL is fixed — do NOT change
ZERNIO_API_KEY=your_zernio_api_key_here

# Webhook security — set a long random string, paste same value in Zernio dashboard
WEBHOOK_SECRET=generate_a_random_secret_here

# Lead qualification settings
CALENDLY_LINK=https://calendly.com/your-username/30min
MIN_BUDGET=500
BUSINESS_NAME=Your Business Name
