ZERNIO_SEND_ENDPOINT=/v1/messages/send

# Webhook security (optional but recommended — set a random secret string)
WEBHOOK_SECRET=your_random_secret_here

# Lead qualification settings
CALENDLY_LINK=https://calendly.com/your-username/30min
MIN_BUDGET=500
BUSINESS_NAME=Your Business Name
